# ~/.blerc — custom color palette
#
# Palette:
#   background: #262C3A
#   skin:       #EBD7CE
#   hair:       #AADBE9
#   shirt:      #98F1DD
#   text:       terminal default (white)

# --- errors / warnings (no red available, using reverse/bold to draw attention) ---
ble-face -s argument_error fg=#262C3A,bg=#EBD7CE,bold
ble-face -s syntax_error fg=#EBD7CE,bold
ble-face -s command_jobs fg=#EBD7CE,bold
ble-face -s filename_warning fg=#EBD7CE,underline
ble-face -s command_builtin_dot fg=#EBD7CE,bold

# --- commands ---
ble-face -s command_builtin bold
ble-face -s command_alias bold
ble-face -s command_file none
ble-face -s command_directory fg=#AADBE9,bold
ble-face -s command_function fg=#AADBE9
ble-face -s command_keyword fg=#AADBE9,bold
ble-face -s command_suffix fg=#262C3A,bg=#AADBE9
ble-face -s command_suffix_new fg=#262C3A,bg=#98F1DD

# --- arguments / options ---
ble-face -s argument_option fg=#AADBE9

# --- general syntax highlighting ---
ble-face -s syntax_default none
ble-face -s syntax_command fg=#EBD7CE
ble-face -s syntax_quoted fg=#AADBE9
ble-face -s syntax_quotation fg=#AADBE9,bold
ble-face -s syntax_escape fg=#98F1DD
ble-face -s syntax_expr fg=#AADBE9
ble-face -s syntax_glob fg=#EBD7CE,bold
ble-face -s syntax_brace fg=#98F1DD,bold
ble-face -s syntax_delimiter bold
ble-face -s syntax_comment fg=#98F1DD
ble-face -s syntax_history_expansion fg=#262C3A,bg=#98F1DD
ble-face -s syntax_param_expansion fg=#98F1DD
ble-face -s syntax_tilde fg=#AADBE9,bold
ble-face -s syntax_varname fg=#EBD7CE
ble-face -s syntax_function_name fg=#AADBE9,bold
ble-face -s syntax_document fg=#98F1DD
ble-face -s syntax_document_begin fg=#98F1DD,bold

# --- variables ---
ble-face -s varname_array fg=#EBD7CE,bold
ble-face -s varname_empty fg=#98F1DD
ble-face -s varname_export fg=#AADBE9,bold
ble-face -s varname_expr fg=#AADBE9,bold
ble-face -s varname_hash fg=#98F1DD,bold
ble-face -s varname_new fg=#AADBE9
ble-face -s varname_number fg=#98F1DD
ble-face -s varname_readonly fg=#AADBE9
ble-face -s varname_transform fg=#98F1DD,bold
ble-face -s varname_unset fg=#98F1DD

# --- files / paths ---
ble-face -s filename_directory fg=#AADBE9,bold
ble-face -s filename_directory_sticky fg=#262C3A,bg=#AADBE9,underline
ble-face -s filename_ls_colors bold
ble-face -s filename_other bold
ble-face -s filename_block fg=#EBD7CE,bg=#262C3A,underline
ble-face -s filename_character fg=#EBD7CE,bg=#262C3A,underline
ble-face -s filename_executable fg=#AADBE9,underline
ble-face -s filename_link fg=#98F1DD,underline
ble-face -s filename_orphan fg=#262C3A,bg=#EBD7CE,underline
ble-face -s filename_pipe fg=#AADBE9,bg=#262C3A,underline
ble-face -s filename_setgid fg=#262C3A,bg=#EBD7CE,underline
ble-face -s filename_setuid fg=#262C3A,bg=#EBD7CE,underline
ble-face -s filename_socket fg=#AADBE9,bg=#262C3A,underline
ble-face -s filename_url fg=#AADBE9,underline

# --- cdpath ---
ble-face -s cmdinfo_cd_cdpath fg=#AADBE9,bg=#98F1DD

# --- selection / region / editing ---
ble-face -s region fg=#EBD7CE,bg=#98F1DD
ble-face -s region_target fg=#262C3A,bg=#AADBE9
ble-face -s region_match fg=#EBD7CE,bg=#98F1DD
ble-face -s region_insert fg=#262C3A,bg=#AADBE9,bold
ble-face -s overwrite_mode fg=#262C3A,bg=#AADBE9
ble-face -s disabled fg=#98F1DD

# --- vbell (visual bell) ---
ble-face -s vbell reverse
ble-face -s vbell_erase bg=#98F1DD
ble-face -s vbell_flash fg=#AADBE9,reverse

# --- prompt / status line ---
ble-face -s prompt_status_line fg=#EBD7CE,bg=#262C3A

# --- auto-complete / menu ---
ble-face -s auto_complete fg=#98F1DD
ble-face -s menu_complete_match bold
ble-face -s menu_complete_selected reverse
ble-face -s menu_desc_default none
ble-face -s menu_desc_quote ref:syntax_quoted
ble-face -s menu_desc_type ref:syntax_delimiter
ble-face -s menu_filter_fixed bold
ble-face -s menu_filter_input fg=#262C3A,bg=#EBD7CE